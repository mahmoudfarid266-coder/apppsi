# EAS builds run on macOS/Linux. CRLF in shell scripts, Gradle wrappers, and
# Ruby/Fastlane files breaks those builds. Normalize everything to LF.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binaries
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.ttf  binary
*.otf  binary
*.woff  binary
*.woff2 binary
*.mp3  binary
*.wav  binary
*.ipa  binary
*.keystore binary
